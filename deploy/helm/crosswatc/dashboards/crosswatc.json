{
  "title": "Crosswatc",
  "uid": "crosswatc",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Resources by state",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (state) (crosswatc_resources_total)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API availability (5xx ratio)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "crosswatc:api_error_ratio:rate5m",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GET /resources/{id} p95 (SLO 400ms)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "crosswatc:get_resource_latency:p95_5m",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event ingestion lag p95 (SLO 3s \u2192 UI)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "crosswatc:event_ingestion_lag:p95_5m",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reconcile duration p95 (SLO 10s)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "crosswatc:reconcile_duration:p95_5m",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Operations",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(crosswatc_operations_total[1h]))",
          "legendFormat": "{{type}}"
        },
        {
          "expr": "sum by (type) (increase(crosswatc_operations_failed_total[1h]))",
          "legendFormat": "failed {{type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Revision duration p50/p95",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(crosswatc_revision_duration_seconds_bucket[1h])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crosswatc_revision_duration_seconds_bucket[1h])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time per revision state p95",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, state) (rate(crosswatc_stage_duration_seconds_bucket[1h])))",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "SSE connections",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(crosswatc_sse_connections)",
          "legendFormat": "open"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drift",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(crosswatc_drift_active)",
          "legendFormat": "active"
        },
        {
          "expr": "increase(crosswatc_drift_total[1h])",
          "legendFormat": "new/h"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Informer restarts",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (watch) (increase(crosswatc_informer_restarts_total[10m]))",
          "legendFormat": "{{watch}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Webhook failures",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (source, reason) (increase(crosswatc_webhook_failures_total[10m]))",
          "legendFormat": "{{source}} {{reason}}"
        }
      ]
    }
  ],
  "tags": [
    "crosswatc"
  ]
}
